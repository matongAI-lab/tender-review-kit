      "id": "emphasis_marks",
      "name": "强调标识参数",
      "level": "special",
      "match_type": "emphasis",
      "scope_required": false,
      "report_section": "八、▲/★ 标识参数",
      "_doc": "识别招标文件中的强调标识（▲/★/◆/● 等）— 通常表示「实质性响应项」，不响应即否决。自适应识别本份文档实际使用的标识。▲/★ 在招标文件中几乎专用于强调，故阈值=1（少量也不丢，呼应『有多少列多少』）；◆●※■◇☆/* 常兼作项目符号/脚注，保留较高阈值去噪。* 另有正则限定（行首或单元格首 + 紧跟中文）再过滤一层。",
      "candidates": [
        "▲",
        "★",
        "◆",
        "●",
        "※",
        "■",
        "◇",
        "☆",
        "*"
      ],
      "min_occurrences": 3,
      "min_occurrences_overrides": {
        "▲": 1,
        "★": 1
      },
      "auto_detect": true
    }
  ],
  "exclude_patterns_global": [
